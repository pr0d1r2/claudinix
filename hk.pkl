/// claudinix's gate, defined ONCE (SPEC C14).
///
/// Every step is ONE plain command a human can paste (SPEC C15): no pipes,
/// no `&&`, no `||`. Logic lives in bats-covered scripts under `scripts/`,
/// never inline here. External tools run through `scripts/hk/run-tool.sh`,
/// so a missing tool fails as "gate could not run" instead of passing
/// (V18).
///
/// CI runs this same set (`hk check --all`), so a local pass means what a
/// CI pass means (V22). The schema is vendored at `pkl/Config.pkl`
/// (hk v1.58.1, verbatim) so the gate needs no network.
amends "pkl/Config.pkl"

/// Locally the loop is cheap, so the first failure is the most useful
/// thing to see; CI passes `--no-fail-fast` to get every failure at once.
fail_fast = true

/// Success is silence: output that always appears is output nobody reads.
env {
  ["HK_HIDE_WHEN_DONE"] = "true"
  // Without a terminal hk prints every step's start as a log line: a
  // green `hk check --all` piped to a file was 350 lines an agent pays
  // for and nobody reads (V31). `--quiet` would do it but is a CLI flag
  // only, and every caller would have to remember it; clx (hk's output
  // library) reads this variable once hk has applied this block. Failing
  // steps still print their output and the fix command.
  ["CLX_NO_PROGRESS"] = "1"
}

/// LAYER ONE: every commit. Scoped by glob, so a doc-only commit never
/// waits on the shell linters.
local fast = new Mapping<String, Step> {
  // `.envrc` is shell that runs on every directory entry, so it is linted
  // like the scripts. bats files are bash with `@test` blocks, which
  // shellcheck and shfmt both read.
  ["shellcheck"] {
    glob = List("**/*.sh", "**/*.bats", ".envrc")
    check = "scripts/hk/run-tool.sh shellcheck {{files}}"
  }
  ["shfmt"] {
    glob = List("**/*.sh", "**/*.bats")
    check = "scripts/hk/run-tool.sh shfmt --diff --indent 4 {{files}}"
    fix = "scripts/hk/run-tool.sh shfmt --write --indent 4 {{files}}"
  }
  ["nixfmt"] {
    glob = List("**/*.nix")
    check = "scripts/hk/run-tool.sh nixfmt --check {{files}}"
    fix = "scripts/hk/run-tool.sh nixfmt {{files}}"
  }

  // One language per file (SPEC C15): no shell embedded in nix strings.
  // xnl skips files no host claims, so the glob only keeps the step off
  // commits that touch neither language.
  ["xenolith"] {
    glob = List("**/*.nix", "**/*.sh", "**/*.bats", "xenolith.toml")
    check = "scripts/hk/run-tool.sh xnl check {{files}}"
  }

  // The justfile holds one plain command per recipe (C15); just's own
  // formatter keeps its layout. `--unstable` because `--fmt` still asks
  // for it.
  ["just"] {
    glob = List("justfile")
    check = "scripts/hk/run-tool.sh just --fmt --check --unstable"
    fix = "scripts/hk/run-tool.sh just --fmt --unstable"
  }

  // hk parses its config leniently, so a file it accepts may still be
  // invalid Pkl (B5). The official evaluator is the judge (V27).
  ["pkl-eval"] {
    glob = List("hk.pkl", "pkl/*.pkl")
    check = "scripts/hk/run-tool.sh pkl eval --output-path /dev/null hk.pkl"
  }

  // The workflow is the one file no other local step exercises. actionlint
  // checks syntax and types; zizmor audits security posture. `--offline`
  // because a gate must not need the network, and in a cloud session the
  // injected GH_TOKEN placeholder makes online audits fail with 401
  // (SPEC C6, C8).
  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "scripts/hk/run-tool.sh actionlint {{files}}"
  }
  ["zizmor"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "scripts/hk/run-tool.sh zizmor --offline --no-progress --persona=pedantic {{files}}"
  }

  // The spec toolchain (SPEC C20). The spec is federated: one SPEC.md
  // per node (root, scripts, nix, docs). microlith owns the format --
  // `mth fmt` is whitespace-only, `mth check` the structural rules --
  // and takes one path per run, so `workspace_indicator` runs it once
  // per changed node. itok gates token ceilings in `.context-limits`;
  // sherd validates the federation, checks citations across nodes,
  // keeps each §N in step with its parent's §F, and budgets every
  // chain. A missing tool fails through run-tool.sh (V18).
  ["spec-fmt"] {
    glob = List("**/SPEC.md")
    workspace_indicator = "SPEC.md"
    check = "scripts/hk/run-tool.sh mth fmt --check {{workspace}}/SPEC.md"
    fix = "scripts/hk/run-tool.sh mth fmt {{workspace}}/SPEC.md"
  }
  ["spec-check"] {
    glob = List("**/SPEC.md")
    workspace_indicator = "SPEC.md"
    depends = List("spec-fmt")
    check = "scripts/hk/run-tool.sh mth check {{workspace}}/SPEC.md"
  }
  ["spec-tokens"] {
    glob = List("**/SPEC.md", ".context-limits")
    check = "scripts/hk/run-tool.sh itok check"
  }
  ["federation"] {
    glob = List("**/SPEC.md", ".context-limits")
    check = "scripts/hk/run-tool.sh sherd validate"
  }
  ["nav"] {
    glob = List("**/SPEC.md")
    depends = List("federation")
    check = "scripts/hk/run-tool.sh sherd sync --check"
    fix = "scripts/hk/run-tool.sh sherd sync"
  }
  ["spec-structure"] {
    glob = List("**/SPEC.md")
    depends = List("federation")
    check = "scripts/hk/run-tool.sh sherd check"
  }
  ["budget"] {
    glob = List("**/SPEC.md", ".context-limits")
    depends = List("federation")
    check = "scripts/hk/run-tool.sh sherd budget"
  }

  ["typos"] {
    glob = List("**/*")
    check = "scripts/hk/run-tool.sh typos --force-exclude {{files}}"
    fix = "scripts/hk/run-tool.sh typos --force-exclude --write-changes {{files}}"
  }

  // Secrets, in two steps, because they answer different questions:
  // `detect-private-key` finds key blocks only, ripsecrets finds token
  // shapes. The repo is public from its first push (SPEC V6, V12).
  ["no-private-key"] {
    glob = List("**/*")
    check = "hk util detect-private-key {{files}}"
  }
  ["ripsecrets"] {
    glob = List("**/*")
    check = "scripts/hk/run-tool.sh ripsecrets {{files}}"
  }

  // The cheap hygiene family from `hk util`: no extra binary to pin.
  ["trailing-whitespace"] {
    glob = List("**/*")
    check = "hk util trailing-whitespace {{files}}"
    fix = "hk util trailing-whitespace --fix {{files}}"
  }
  ["final-newline"] {
    glob = List("**/*")
    check = "hk util end-of-file-fixer {{files}}"
    fix = "hk util end-of-file-fixer --fix {{files}}"
  }
  ["line-endings"] {
    glob = List("**/*")
    check = "hk util mixed-line-ending {{files}}"
    fix = "hk util mixed-line-ending --fix {{files}}"
  }
  ["no-large-files"] {
    glob = List("**/*")
    check = "hk util check-added-large-files {{files}}"
  }
  ["no-merge-conflict"] {
    glob = List("**/*")
    check = "hk util check-merge-conflict --assume-in-merge {{files}}"
  }

  // The README's paste line is generated (C25): the block must be what
  // setup-line.sh prints for the SHA it names. Offline, no gh call.
  ["readme-setup-line"] {
    glob = List("README.md", "scripts/setup-line.sh", "scripts/guard/readme-setup-line.sh")
    check = "scripts/guard/readme-setup-line.sh"
  }

  // The dev crate (dev:C31): rustfmt, then clippy; its tests run on push
  // (`dev-test` below). Chained with `depends` because cargo locks the
  // target dir, so parallel cargo runs would only queue on the lock.
  ["dev-fmt"] {
    glob = List("dev/**")
    check = "scripts/hk/run-tool.sh cargo fmt --check --manifest-path dev/Cargo.toml"
    fix = "scripts/hk/run-tool.sh cargo fmt --manifest-path dev/Cargo.toml"
  }
  ["dev-clippy"] {
    glob = List("dev/**")
    depends = List("dev-fmt")
    check = "scripts/hk/run-tool.sh cargo clippy --quiet --all-targets --manifest-path dev/Cargo.toml -- -D warnings"
  }

  // The README badges are generated (T105, dev:V1): every file a badge
  // reads is in the glob, so a new bats test, a gate step or a Nix floor
  // change reruns the check (V19). The tool's own source too: a template
  // change must rerun it.
  ["readme-badges"] {
    glob = List(
      "README.md",
      "LICENSE",
      "setup.sh",
      ".claudinix.toml",
      "hk.pkl",
      "pkl/*.pkl",
      "SPEC.md",
      ".github/workflows/ci.yml",
      "tests/unit/**/*.bats",
      "dev/**"
    )
    check = "scripts/hk/run-tool.sh claudinix-dev badges --check"
    fix = "scripts/hk/run-tool.sh claudinix-dev badges --write"
  }
  // The step counts docs/INTEGRATION.md states equal hk.pkl's (T105).
  ["integration-counts"] {
    glob = List("docs/INTEGRATION.md", "hk.pkl", "pkl/*.pkl", "dev/**")
    check = "scripts/hk/run-tool.sh claudinix-dev counts --check"
    fix = "scripts/hk/run-tool.sh claudinix-dev counts --write"
  }
  // The flake inputs table in the notices is generated from flake.lock
  // (dev:T109), so an input bump reruns it (V19).
  ["third-party-notices"] {
    glob = List("docs/THIRD-PARTY-NOTICES.md", "flake.lock", "dev/**")
    check = "scripts/hk/run-tool.sh claudinix-dev notices --check"
    fix = "scripts/hk/run-tool.sh claudinix-dev notices --write"
  }

  // This repo's own .claudinix.toml must pass the reader every tool uses
  // (T92, scripts:V34). The reader and its schema are data the check
  // depends on, so a change to them reruns it (V19). config.sh needs nix
  // and jq and fails loudly without them, never passes (V18).
  ["claudinix-config"] {
    glob = List(".claudinix.toml", "scripts/config.sh", "scripts/config.jq")
    check = "scripts/config.sh check"
  }

  // The one rule list cloud sessions get stays narrow and keeps the deny
  // rules against pushing main; the committed project settings, which
  // local sessions read, carry none (T101). jq missing fails (V18).
  ["cloud-permissions"] {
    glob = List("nix/cloud-permissions.json", ".claude/settings.json", "scripts/guard/cloud-permissions.sh")
    check = "scripts/guard/cloud-permissions.sh"
  }

  // A shebang script tracked as 100644 answers "permission denied" (B6).
  // Whole-repo glob: a mode-only change is still a change (V19, V28).
  ["exec-bit"] {
    glob = List("**/*")
    check = "scripts/guard/exec-bit.sh"
  }
}

/// LAYER TWO: everything above plus the steps that judge the branch rather
/// than one commit. A TDD RED commit is red on purpose (SPEC C17), so the
/// suite gates the push, not each commit.
local all = (fast) {
  // The whole suite, not the mirrored file: a change to any test must run
  // beside the others it shares helpers with. Parallel through
  // BATS_NUMBER_OF_PARALLEL_JOBS from the dev shell (C18). The glob
  // follows the data: besides code, the tests read the jq programs, the
  // guide's TSV, the text lists, the justfile, SETUP.md and fixtures, so
  // a change to any of those reruns them (V19).
  ["bats"] {
    glob = List(
      "**/*.sh",
      "**/*.bats",
      "**/*.jq",
      "**/*.tsv",
      "**/*.txt",
      "justfile",
      "docs/SETUP.md",
      "tests/fixtures/**"
    )
    check = "scripts/hk/run-tool.sh bats --recursive tests/unit"
  }

  // The dev crate's tests, on push like the bats suite: a RED commit
  // lands a failing Rust test on purpose (C17). After clippy, which
  // holds the same cargo lock.
  ["dev-test"] {
    glob = List("dev/**")
    depends = List("dev-clippy")
    check = "scripts/hk/run-tool.sh cargo test --quiet --manifest-path dev/Cargo.toml"
  }

  // The mirror rule is a property of the branch, not of every commit: a
  // RED commit lands a test before its script exists, so checking it on
  // pre-commit would make RED commits impossible (xenolith
  // `scripts/guard` B1). Whole-repo glob, because the change that breaks
  // it -- a rename or a deletion -- is not a file the step is handed
  // (V19).
  ["bats-mirror"] {
    glob = List("**/*")
    check = "scripts/guard/bats-mirror.sh"
  }
  // Ordering is a property of history: reads the range a push publishes,
  // so every file counts as a trigger.
  ["tdd-order"] {
    glob = List("**/*")
    check = "scripts/guard/tdd-order.sh"
  }
}

hooks {
  // `stash = "git"` is correctness: without it a partially staged file is
  // checked as it looks in the worktree, not as it is being committed.
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }
  // A message is not a file in the tree, so this step lives only here.
  // The script finds COMMIT_EDITMSG itself, keeping the step one command.
  ["commit-msg"] {
    steps {
      ["commit-msg"] {
        check = "scripts/guard/commit-msg.sh"
      }
    }
  }
  ["pre-push"] {
    steps = all
  }
  // The entry point for CI and for a full run by hand: `hk check --all`.
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    steps = fast
  }
}
